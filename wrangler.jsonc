{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "binhyen",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "binhyen-db",
			"database_id": "438b05f8-ce0c-4ab8-885e-74b365e22719"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "binhyen-media",
			"preview_bucket_name": "binhyen-media-preview"
		}
	],
	"ratelimits": [
		{
			"name": "INTERACTION_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 10 }
		},
		{
			"name": "NEW_ACTOR_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}