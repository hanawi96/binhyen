---
export const prerender = false;

import { env } from "cloudflare:workers";

import type { ContentItem } from "../../features/content/content.types";
import { currentUser, type PublicUser } from "../../features/account/account";
import { createD1AccountStore } from "../../features/account/d1-account-store";
import { listCatalog } from "../../features/admin/d1-catalog";
import { readActorId } from "../../features/actor/actor";
import { attachViewerReactions } from "../../features/feed/feed-rows";
import { loadCollectionFeed } from "../../features/feed/load-collection-feed";
import { createD1MyPostStore } from "../../features/posts/d1-my-posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphereBoot from "../../features/feed/AtmosphereBoot.astro";
import ExploreFeed from "../../features/feed/ExploreFeed.svelte";

const slug = Astro.params.slug ?? "";
const FIRST_PAGE_SIZE = 3;

if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug) || slug.length > 80) {
  return Astro.redirect("/collections");
}

let initialItems: ContentItem[] = [];
let initialCursor: string | null = null;
let collectionMeta:
  | {
      slug: string;
      title: string;
      description: string;
      coverUrl: string;
      coverAlt: string;
      itemCount: number;
    }
  | null = null;
let initialUser: PublicUser | null | undefined;
let initialPostNews = 0;
let initialTopics: Array<{ slug: string; label: string }> = [];

const cookie = Astro.request.headers.get("cookie");
const now = Math.floor(Date.now() / 1000);

try {
  initialUser = await currentUser(createD1AccountStore(env.DB), cookie, now);
  if (initialUser) {
    initialPostNews = await createD1MyPostStore(env.DB).news(initialUser.id);
  }
} catch (error) {
  console.error("Collection page user error:", error);
}

try {
  const catalog = await listCatalog(env.DB);
  initialTopics = catalog.topics.map((topic) => ({
    slug: topic.slug,
    label: topic.label
  }));
} catch (error) {
  console.error("Collection page topics error:", error);
}

try {
  const page = await loadCollectionFeed(env.DB, {
    slug,
    cursor: null,
    limit: FIRST_PAGE_SIZE
  });

  if (!page) {
    return Astro.redirect("/collections");
  }

  const actorId = readActorId(cookie);
  initialItems = await attachViewerReactions(env.DB, page.items, actorId);
  initialCursor = page.nextCursor;
  collectionMeta = page.collection;
} catch (error) {
  console.error("Collection feed error:", error);
  return Astro.redirect("/collections");
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title={`${collectionMeta.title} · Bình Yên`}
  description={collectionMeta.description || collectionMeta.title}
>
  <AtmosphereBoot slot="head" contentId={initialItems[0]?.id ?? null} />
  <ExploreFeed
    client:load
    initialItems={initialItems}
    initialCursor={initialCursor}
    initialMatched={true}
    initialUser={initialUser}
    initialPostNews={initialPostNews}
    initialTopics={initialTopics}
    collection={collectionMeta}
  />
</BaseLayout>
