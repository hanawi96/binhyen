---
export const prerender = false;

import { env } from "cloudflare:workers";

import { hasAdminAccess } from "../../../features/admin/require-admin";
import {
  countSubmissions,
  listSubmissions
} from "../../../features/moderation/d1-submissions";
import AdminSubmissions from "../../../features/moderation/AdminSubmissions.svelte";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!(await hasAdminAccess(Astro.request.headers.get("cookie")))) {
  return Astro.redirect("/admin/login");
}

const [page, counts] = await Promise.all([
  listSubmissions(env.DB, "draft", null, 10),
  countSubmissions(env.DB)
]);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Bài người dùng gửi · Bình Yên"
  description="Duyệt bài người dùng gửi trước khi đăng lên trang chủ."
>
  <AdminSubmissions
    client:load
    initialItems={page.items}
    initialCursor={page.nextCursor}
    initialCounts={counts}
  />
</BaseLayout>
