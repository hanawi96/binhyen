---
export const prerender = false;

import { env } from "cloudflare:workers";

import AdminOperators from "../../../features/admin/AdminOperators.svelte";
import { listAdmins } from "../../../features/admin/d1-admin-accounts";
import { hasAdminAccess } from "../../../features/admin/require-admin";
import { countSubmissions } from "../../../features/moderation/d1-submissions";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!(await hasAdminAccess(Astro.request.headers.get("cookie")))) {
  return Astro.redirect("/admin/login");
}

const [admins, submissions] = await Promise.all([
  listAdmins(env.DB),
  countSubmissions(env.DB)
]);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Quản trị viên · Bình Yên"
  description="Quản lý tài khoản admin trong cơ sở dữ liệu."
>
  <AdminOperators
    client:load
    initialAdmins={admins}
    pending={submissions.draft}
  />
</BaseLayout>
