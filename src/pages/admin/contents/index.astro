---
export const prerender = false;

import { env } from "cloudflare:workers";

import { hasAdminSession } from "../../../features/admin/admin-auth";
import {
  listAdminContents,
  loadAdminCatalog
} from "../../../features/admin/d1-admin-content";
import AdminStudio from "../../../features/admin/AdminStudio.svelte";
import { listCollectionsAdmin } from "../../../features/collections/d1-collections";
import { countSubmissions } from "../../../features/moderation/d1-submissions";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!hasAdminSession(Astro.request.headers.get("cookie"), env.ADMIN_TOKEN)) {
  return Astro.redirect("/admin/login");
}

const [page, catalog, submissions, collections] = await Promise.all([
  listAdminContents(env.DB, {
    status: "all",
    q: "",
    kind: "",
    topic: "",
    sort: "updated",
    review: false,
    cursor: null,
    limit: 12
  }),
  loadAdminCatalog(env.DB),
  countSubmissions(env.DB),
  listCollectionsAdmin(env.DB)
]);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Quản lý nội dung · Bình Yên"
  description="Soạn và xuất bản nội dung trên máy này."
>
  <AdminStudio
    client:load
    initialItems={page.items}
    initialCursor={page.nextCursor}
    initialTotal={page.total}
    initialStats={page.stats}
    initialTopics={catalog.topics}
    initialMoods={catalog.moods}
    initialCollections={collections.map((item) => ({
      id: item.id,
      title: item.title,
      status: item.status
    }))}
    pending={submissions.draft}
  />
</BaseLayout>
