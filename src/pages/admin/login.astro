---
export const prerender = false;

import { hasAdminAccess } from "../../features/admin/require-admin";
import AdminLogin from "../../features/admin/AdminLogin.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";

if (await hasAdminAccess(Astro.request.headers.get("cookie"))) {
  return Astro.redirect("/admin/contents");
}

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Đăng nhập quản trị · Bình Yên"
  description="Đăng nhập phòng quản trị trên máy này."
>
  <AdminLogin client:load />
</BaseLayout>
