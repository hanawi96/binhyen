---
export const prerender = false;

import { env } from "cloudflare:workers";

import AdminAmbient from "../../../features/admin/AdminAmbient.svelte";
import { hasAdminAccess } from "../../../features/admin/require-admin";
import { listAmbientTracks } from "../../../features/ambient/d1-ambient-tracks";
import { countSubmissions } from "../../../features/moderation/d1-submissions";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!(await hasAdminAccess(Astro.request.headers.get("cookie")))) {
  return Astro.redirect("/admin/login");
}

const [tracks, submissions] = await Promise.all([
  listAmbientTracks(env.DB),
  countSubmissions(env.DB)
]);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Nhạc nền · Bình Yên"
  description="Quản lý nhạc thư giãn trên R2."
>
  <AdminAmbient client:load initialTracks={tracks} pending={submissions.draft} />
</BaseLayout>
