---
export const prerender = false;

import { env } from "cloudflare:workers";

import { hasAdminSession } from "../../../features/admin/admin-auth";
import { listCatalog } from "../../../features/admin/d1-catalog";
import AdminCatalog from "../../../features/admin/AdminCatalog.svelte";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!hasAdminSession(Astro.request.headers.get("cookie"), env.ADMIN_TOKEN)) {
  return Astro.redirect("/admin/login");
}

const catalog = await listCatalog(env.DB);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Chủ đề và tâm trạng · Bình Yên"
  description="Đổi tên hiển thị và thứ tự của chủ đề, tâm trạng."
>
  <AdminCatalog
    client:load
    initialTopics={catalog.topics}
    initialMoods={catalog.moods}
  />
</BaseLayout>
