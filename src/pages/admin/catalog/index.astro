---
export const prerender = false;

import { env } from "cloudflare:workers";

import { listCatalog } from "../../../features/admin/d1-catalog";
import AdminCatalog from "../../../features/admin/AdminCatalog.svelte";
import { hasAdminAccess } from "../../../features/admin/require-admin";
import { countSubmissions } from "../../../features/moderation/d1-submissions";
import BaseLayout from "../../../layouts/BaseLayout.astro";

if (!(await hasAdminAccess(Astro.request.headers.get("cookie")))) {
  return Astro.redirect("/admin/login");
}

const [catalog, submissions] = await Promise.all([
  listCatalog(env.DB),
  countSubmissions(env.DB)
]);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<BaseLayout
  title="Chủ đề và tâm trạng · Bình Yên"
  description="Đổi tên hiển thị và thứ tự của chủ đề, tâm trạng."
>
  <AdminCatalog
    client:load
    initialTopics={catalog.topics}
    initialMoods={catalog.moods}
    pending={submissions.draft}
  />
</BaseLayout>
