---
export const prerender = false;

import { env } from "cloudflare:workers";

import type { ContentItem } from "../features/content/content.types";
import { currentUser, type PublicUser } from "../features/account/account";
import { createD1AccountStore } from "../features/account/d1-account-store";
import { listCatalog } from "../features/admin/d1-catalog";
import {
  readFeedViewer,
  resetViewerLoop
} from "../features/feed/d1-viewer-state";
import { loadPublicFeed } from "../features/feed/load-public-feed";
import { createD1MyPostStore } from "../features/posts/d1-my-posts";
import BaseLayout from "../layouts/BaseLayout.astro";
import AtmosphereBoot from "../features/feed/AtmosphereBoot.astro";
import ExploreFeed from "../features/feed/ExploreFeed.svelte";

const FIRST_PAGE_SIZE = 3;

let initialItems: ContentItem[] = [];
let initialCursor: string | null = null;
let initialPageCursor: string | null = null;
let initialMatched = true;
let initialNotice: "all-seen" | null = null;
let initialUser: PublicUser | null | undefined;
let initialPostNews = 0;
let initialTopics: Array<{ slug: string; label: string }> = [];

const cookie = Astro.request.headers.get("cookie");
const now = Math.floor(Date.now() / 1000);

// Song song user / catalog / feed — khong phu thuoc lan nhau.
const [userBundle, topics, feedPage] = await Promise.all([
  (async () => {
    try {
      const user = await currentUser(createD1AccountStore(env.DB), cookie, now);
      const postNews = user
        ? await createD1MyPostStore(env.DB).news(user.id)
        : 0;
      return { user, postNews };
    } catch (error) {
      console.error("Homepage user error:", error);
      return { user: undefined as PublicUser | null | undefined, postNews: 0 };
    }
  })(),
  (async () => {
    try {
      const catalog = await listCatalog(env.DB);
      return catalog.topics.map((topic) => ({
        slug: topic.slug,
        label: topic.label
      }));
    } catch (error) {
      console.error("Homepage topics error:", error);
      return [] as Array<{ slug: string; label: string }>;
    }
  })(),
  (async () => {
    try {
      const viewer = await readFeedViewer(env.DB, cookie, now);
      return await loadPublicFeed(env.DB, {
        topic: "all",
        mood: "all",
        cursor: null,
        limit: FIRST_PAGE_SIZE,
        viewer,
        onAllSeen: () => resetViewerLoop(env.DB, viewer, now)
      });
    } catch (error) {
      console.error("Homepage feed error:", error);
      return null;
    }
  })()
]);

initialUser = userBundle.user;
initialPostNews = userBundle.postNews;
initialTopics = topics;

if (feedPage) {
  initialItems = feedPage.items;
  initialCursor = feedPage.nextCursor;
  initialPageCursor = feedPage.pageCursor;
  initialMatched = feedPage.matched;
  initialNotice = feedPage.notice;
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title="Bình Yên - Một khoảng lặng dành cho bạn"
  description="Khám phá những câu chuyện, góc nhìn và điều đẹp đẽ nhỏ bé trong cuộc sống."
>
  <AtmosphereBoot slot="head" contentId={initialItems[0]?.id ?? null} />
  <ExploreFeed
    client:load
    initialItems={initialItems}
    initialCursor={initialCursor}
    initialPageCursor={initialPageCursor}
    initialMatched={initialMatched}
    initialNotice={initialNotice}
    initialUser={initialUser}
    initialPostNews={initialPostNews}
    initialTopics={initialTopics}
  />
</BaseLayout>
