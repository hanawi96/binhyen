
---
export const prerender = false;

import { env } from "cloudflare:workers";

import type { ContentItem } from "../features/content/content.types";
import { currentUser, type PublicUser } from "../features/account/account";
import { createD1AccountStore } from "../features/account/d1-account-store";
import {
  readFeedViewer,
  resetViewerLoop
} from "../features/feed/d1-viewer-state";
import { loadPublicFeed } from "../features/feed/load-public-feed";
import { createD1MyPostStore } from "../features/posts/d1-my-posts";
import BaseLayout from "../layouts/BaseLayout.astro";
import ExploreFeed from "../features/feed/ExploreFeed.svelte";

const FIRST_PAGE_SIZE = 3;

let initialItems: ContentItem[] = [];
let initialCursor: string | null = null;
let initialPageCursor: string | null = null;
let initialMatched = true;
let initialNotice: "all-seen" | null = null;
let initialUser: PublicUser | null | undefined;
let initialPostNews = 0;

const cookie = Astro.request.headers.get("cookie");
const now = Math.floor(Date.now() / 1000);

try {
  initialUser = await currentUser(createD1AccountStore(env.DB), cookie, now);
  if (initialUser) {
    initialPostNews = await createD1MyPostStore(env.DB).news(initialUser.id);
  }
} catch (error) {
  console.error("Homepage user error:", error);
}

try {
  const viewer = await readFeedViewer(env.DB, cookie, now);
  const page = await loadPublicFeed(env.DB, {
    topic: "all",
    mood: "all",
    cursor: null,
    limit: FIRST_PAGE_SIZE,
    viewer,
    onAllSeen: () => resetViewerLoop(env.DB, viewer, now)
  });

  initialItems = page.items;
  initialCursor = page.nextCursor;
  initialPageCursor = page.pageCursor;
  initialMatched = page.matched;
  initialNotice = page.notice;
} catch (error) {
  console.error("Homepage feed error:", error);
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title="Bình Yên - Một khoảng lặng dành cho bạn"
  description="Khám phá những câu chuyện, góc nhìn và điều đẹp đẽ nhỏ bé trong cuộc sống."
>
  <ExploreFeed
    client:load
    initialItems={initialItems}
    initialCursor={initialCursor}
    initialPageCursor={initialPageCursor}
    initialMatched={initialMatched}
    initialNotice={initialNotice}
    initialUser={initialUser}
    initialPostNews={initialPostNews}
  />
</BaseLayout>
