
import type { APIRoute } from "astro";
import { env } from "cloudflare:workers";

import type {
  ContentItem,
  ContentKind,
  ContentStatus,
  ContentTheme,
  ContentTopic,
  ContentMood
} from "../../features/content/content.types";

export const prerender = false;

interface ContentRow {
  id: string;
  slug: string;
  kind: string;
  status: string;
  category: string;
  title: string;
  description: string;
  tag: string;
  theme: string;
  topics_json: string;
  moods_json: string;
}

export const GET: APIRoute = async ({ request }) => {
  const url = new URL(request.url);

  const limitParam = url.searchParams.get("limit");
  const cursor = url.searchParams.get("cursor");

  // Chi chap nhan limit la so nguyen 1-20.
  const limit = limitParam === null
    ? 10
    : Number(limitParam);

  if (
    !Number.isSafeInteger(limit) ||
    limit < 1 ||
    limit > 20
  ) {
    return Response.json(
      { success: false, error: "Invalid limit" },
      { status: 400 }
    );
  }

  // Cursor hien tai la ID van ban.
  if (
    cursor !== null &&
    (cursor.length === 0 || cursor.length > 128)
  ) {
    return Response.json(
      { success: false, error: "Invalid cursor" },
      { status: 400 }
    );
  }

  try {
    const sql = `
      SELECT
        c.id,
        c.slug,
        c.kind,
        c.status,
        c.category,
        c.title,
        c.description,
        c.tag,
        c.theme,

        COALESCE(
          (
            SELECT json_group_array(ct.topic_slug)
            FROM content_topics ct
            WHERE ct.content_id = c.id
          ),
          '[]'
        ) AS topics_json,

        COALESCE(
          (
            SELECT json_group_array(cm.mood_slug)
            FROM content_moods cm
            WHERE cm.content_id = c.id
          ),
          '[]'
        ) AS moods_json

      FROM contents c

      WHERE c.status = 'published'
        AND (?1 IS NULL OR c.id > ?1)

      ORDER BY c.id ASC

      LIMIT ?2
    `;

    // Lay them 1 ban ghi de biet con trang sau.
    const result = await env.DB
      .prepare(sql)
      .bind(cursor, limit + 1)
      .all<ContentRow>();

    const rows = result.results;

    const hasMore = rows.length > limit;
    const pageRows = rows.slice(0, limit);

    const items: ContentItem[] = pageRows.map(
      (row) => ({
        id: row.id,
        slug: row.slug,

        kind: row.kind as ContentKind,
        status: row.status as ContentStatus,

        category: row.category,
        title: row.title,
        description: row.description,
        tag: row.tag,

        theme: row.theme as ContentTheme,

        topics: JSON.parse(
          row.topics_json
        ) as ContentTopic[],

        suitableMoods: JSON.parse(
          row.moods_json
        ) as ContentMood[]
      })
    );

    const nextCursor =
      hasMore && items.length > 0
        ? items[items.length - 1].id
        : null;

    return Response.json(
      {
        success: true,
        items,
        nextCursor,
        hasMore
      },
      {
        headers: {
          "Cache-Control": "no-store",
          "X-Content-Type-Options": "nosniff"
        }
      }
    );
  } catch (error) {
    console.error("Feed API failed:", error);

    return Response.json(
      {
        success: false,
        error: "Unable to load content"
      },
      {
        status: 500,
        headers: {
          "Cache-Control": "no-store"
        }
      }
    );
  }
};
