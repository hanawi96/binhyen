---
export const prerender = false;

import { env } from "cloudflare:workers";

import { listCollectionsPublic } from "../../features/collections/d1-collections";
import BaseLayout from "../../layouts/BaseLayout.astro";

const collections = await listCollectionsPublic(env.DB).catch((error) => {
  console.error("collections page error:", error);
  return [];
});

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title="Bộ sưu tập · Bình Yên"
  description="Những tuyển tập được biên soạn — vuốt như trang chủ."
>
  <main class="page">
    <header class="hero">
      <a class="back" href="/">← Trang chủ</a>
      <h1>Bộ sưu tập</h1>
      <p>Chọn một bộ — rồi vuốt từng thẻ như khi khám phá.</p>
    </header>

    {#if collections.length === 0}
      <p class="empty">Chưa có bộ nào được xuất bản.</p>
    {:else}
      <ul class="grid">
        {
          collections.map((item) => (
            <li>
              <a class="card" href={`/c/${item.slug}`}>
                <h2>{item.title}</h2>
                {item.description ? <p>{item.description}</p> : null}
                <span class="count">{item.itemCount} câu</span>
              </a>
            </li>
          ))
        }
      </ul>
    {/if}
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at top left, var(--scene-glow-sage) 0%, transparent 34%),
      radial-gradient(circle at bottom right, var(--scene-glow-warm) 0%, transparent 34%),
      linear-gradient(180deg, var(--scene-top) 0%, var(--color-background) 100%);
    color: var(--color-text);
  }

  .hero {
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .hero > p,
  .empty {
    margin: 0;
    color: var(--color-text-secondary);
    max-width: 36rem;
    line-height: 1.5;
  }

  .empty {
    max-width: 720px;
    margin: 0 auto;
  }

  .grid {
    list-style: none;
    max-width: 720px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .card {
    display: grid;
    gap: 0.45rem;
    padding: 1.15rem 1.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .card h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .card p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .count {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
