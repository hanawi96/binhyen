---
export const prerender = false;

import { env } from "cloudflare:workers";

import { listCollectionsPublic } from "../../features/collections/d1-collections";
import BaseLayout from "../../layouts/BaseLayout.astro";

const collections = await listCollectionsPublic(env.DB).catch((error) => {
  console.error("collections page error:", error);
  return [];
});

const featured = collections[0] ?? null;
const rest = collections.slice(1);
const marks = ["❋", "✧", "✳", "❀", "☼", "♡"] as const;

function padIndex(n: number): string {
  return String(n).padStart(2, "0");
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title="Bộ sưu tập · Bình Yên"
  description="Những tuyển tập được biên soạn — chọn một bộ rồi vuốt như trang chủ."
>
  <main class="page">
    <div class="atmosphere" aria-hidden="true"></div>

    <header class="mast">
      <a class="back" href="/">← Trang chủ</a>
      <p class="brand">Bình Yên</p>
      <h1 class="page-title">Bộ sưu tập</h1>
      <p class="lede">
        Tuyển tập được biên soạn — chọn một bộ, rồi vuốt từng thẻ.
      </p>
    </header>

    {
      collections.length === 0 ? (
        <div class="empty">
          <p>Chưa có tuyển tập nào được mở.</p>
          <a class="empty-home" href="/">
            Về trang chủ
          </a>
        </div>
      ) : (
        <div class="gallery">
          {featured ? (
            <a
              class="feature"
              href={`/c/${featured.slug}`}
              style="--stagger: 0"
            >
              <span class="feature-media">
                {featured.coverUrl ? (
                  <img
                    src={featured.coverUrl}
                    alt={featured.coverAlt || featured.title}
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  <span class="feature-placeholder">
                    <span aria-hidden="true">{marks[0]}</span>
                  </span>
                )}
              </span>
              <span class="feature-veil" aria-hidden="true" />
              <span class="feature-copy">
                <span class="feature-index" aria-hidden="true">
                  {padIndex(1)}
                </span>
                <span class="feature-kicker">Đề xuất</span>
                <span class="feature-title">{featured.title}</span>
                {featured.description ? (
                  <span class="feature-desc">{featured.description}</span>
                ) : null}
                <span class="feature-meta">
                  <span>{featured.itemCount} câu</span>
                  <span class="feature-go">Vào bộ →</span>
                </span>
              </span>
            </a>
          ) : null}

          {rest.length > 0 ? (
            <ol class="folio">
              {rest.map((item, index) => {
                const n = index + 2;
                const side = index % 2 === 0 ? "left" : "right";
                return (
                  <li
                    class={`folio-item folio-${side}`}
                    style={`--stagger: ${Math.min(index + 1, 6)}`}
                  >
                    <a class="folio-link" href={`/c/${item.slug}`}>
                      <span class="folio-media">
                        {item.coverUrl ? (
                          <img
                            src={item.coverUrl}
                            alt={item.coverAlt || item.title}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="folio-placeholder">
                            <span aria-hidden="true">
                              {marks[n % marks.length]}
                            </span>
                          </span>
                        )}
                      </span>
                      <span class="folio-copy">
                        <span class="folio-index" aria-hidden="true">
                          {padIndex(n)}
                        </span>
                        <span class="folio-title">{item.title}</span>
                        {item.description ? (
                          <span class="folio-desc">{item.description}</span>
                        ) : null}
                        <span class="folio-meta">
                          {item.itemCount} câu · mở bộ
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          ) : null}
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1.1rem, 4vw, 2.75rem)
      clamp(3.5rem, 10vw, 6rem);
    overflow: clip;
    color: var(--color-text);
    background: var(--color-background);
  }

  .atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 80% 55% at 8% -5%,
        color-mix(in srgb, var(--scene-glow-sage) 85%, transparent),
        transparent 58%
      ),
      radial-gradient(
        ellipse 70% 50% at 100% 35%,
        color-mix(in srgb, var(--scene-glow-warm) 70%, transparent),
        transparent 55%
      ),
      radial-gradient(
        ellipse 50% 40% at 40% 100%,
        color-mix(in srgb, var(--color-primary) 12%, transparent),
        transparent 60%
      ),
      linear-gradient(
        180deg,
        var(--scene-top) 0%,
        var(--color-background) 55%,
        var(--color-background) 100%
      );
  }

  .mast {
    max-width: 68rem;
    margin: 0 auto 2.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .brand {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(2.8rem, 8vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .page-title {
    margin: 0.55rem 0 0.75rem;
    color: var(--color-brand-mark);
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .lede {
    margin: 0;
    max-width: 26rem;
    color: var(--color-text-secondary);
    font-size: clamp(0.98rem, 1.8vw, 1.08rem);
    line-height: 1.5;
  }

  .mast .back,
  .mast .brand,
  .mast .page-title,
  .mast .lede {
    animation: rise-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mast .brand {
    animation-delay: 40ms;
  }

  .mast .page-title {
    animation-delay: 90ms;
  }

  .mast .lede {
    animation-delay: 130ms;
  }

  .empty {
    max-width: 40rem;
    margin: 0 auto;
    animation: rise-in 420ms ease both;
  }

  .empty p {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
    font-family: var(--font-editorial);
    font-size: clamp(1.3rem, 3vw, 1.65rem);
    line-height: 1.4;
  }

  .empty-home {
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .gallery {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 68rem;
    margin: 0 auto;
  }

  /* —— Featured —— */
  .feature {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: clamp(22rem, 58vw, 34rem);
    border-radius: 2px;
    color: inherit;
    text-decoration: none;
    animation: rise-in 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(160ms + var(--stagger, 0) * 60ms);
  }

  .feature-media,
  .feature-placeholder {
    position: absolute;
    inset: 0;
  }

  .feature-media img,
  .feature-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        circle at 28% 30%,
        color-mix(in srgb, var(--color-primary) 28%, transparent),
        transparent 55%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-theme-peace) 80%, var(--color-background)),
        color-mix(in srgb, var(--color-theme-nature) 55%, var(--color-background))
      );
    color: var(--color-ornament);
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .feature-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--color-background) 88%, transparent) 0%,
      color-mix(in srgb, var(--color-background) 55%, transparent) 42%,
      color-mix(in srgb, var(--color-background) 8%, transparent) 72%
    );
  }

  .feature-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.55rem;
    align-content: end;
    min-height: inherit;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    max-width: min(34rem, 92%);
  }

  .feature-index {
    color: color-mix(in srgb, var(--color-text) 22%, transparent);
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.85;
  }

  .feature-kicker {
    color: var(--color-brand-mark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .feature-title {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 5.2vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .feature-desc {
    display: -webkit-box;
    overflow: hidden;
    max-width: 28rem;
    color: var(--color-text-secondary);
    font-size: 1.02rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    align-items: center;
    margin-top: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .feature-go {
    color: var(--color-primary);
    font-weight: 650;
  }

  .feature-media img {
    transform: scale(1.02);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .feature:hover .feature-media img,
    .feature:focus-visible .feature-media img {
      transform: scale(1.06);
    }

    .feature:hover .feature-go,
    .feature:focus-visible .feature-go {
      letter-spacing: 0.02em;
    }
  }

  .feature:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
    outline-offset: 4px;
  }

  /* —— Folio rows —— */
  .folio {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.2rem, 5vw, 3.75rem);
  }

  .folio-item {
    animation: rise-in 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(220ms + var(--stagger, 0) * 70ms);
  }

  .folio-link {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.25rem);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .folio-right .folio-link {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }

  .folio-right .folio-media {
    order: 2;
  }

  .folio-right .folio-copy {
    order: 1;
  }

  .folio-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .folio-left .folio-media {
    aspect-ratio: 4 / 5;
    max-height: 28rem;
    margin-inline: 0 auto 0 0;
    width: min(100%, 26rem);
  }

  .folio-right .folio-media {
    aspect-ratio: 16 / 11;
    margin-inline: auto 0 0 auto;
    width: min(100%, 32rem);
  }

  .folio-media img,
  .folio-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .folio-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        circle at 70% 30%,
        color-mix(in srgb, var(--color-primary) 22%, transparent),
        transparent 50%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-theme-story) 70%, var(--color-background)),
        color-mix(in srgb, var(--color-theme-peace) 55%, var(--color-background))
      );
    color: var(--color-ornament);
    font-family: var(--font-editorial);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .folio-media img {
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .folio-copy {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
    padding-block: 0.25rem;
  }

  .folio-right .folio-copy {
    text-align: right;
    justify-items: end;
  }

  .folio-index {
    color: color-mix(in srgb, var(--color-text) 18%, transparent);
    font-family: var(--font-editorial);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .folio-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.65rem, 3.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.18;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .folio-desc {
    display: -webkit-box;
    overflow: hidden;
    max-width: 26rem;
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .folio-meta {
    color: var(--color-primary);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  @media (hover: hover) and (pointer: fine) {
    .folio-link:hover .folio-media img,
    .folio-link:focus-visible .folio-media img {
      transform: scale(1.05);
    }

    .folio-left .folio-link:hover .folio-title,
    .folio-left .folio-link:focus-visible .folio-title {
      transform: translateX(6px);
    }

    .folio-right .folio-link:hover .folio-title,
    .folio-right .folio-link:focus-visible .folio-title {
      transform: translateX(-6px);
    }
  }

  .folio-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
    outline-offset: 6px;
    border-radius: 4px;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 720px) {
    .folio-link,
    .folio-right .folio-link {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .folio-right .folio-media,
    .folio-left .folio-media {
      order: 0;
      width: 100%;
      max-height: none;
      aspect-ratio: 16 / 11;
      margin: 0;
    }

    .folio-right .folio-copy,
    .folio-left .folio-copy {
      order: 1;
      text-align: left;
      justify-items: start;
    }

    .feature-copy {
      max-width: 100%;
    }

    .feature-veil {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-background) 10%, transparent) 20%,
        color-mix(in srgb, var(--color-background) 78%, transparent) 72%,
        color-mix(in srgb, var(--color-background) 92%, transparent) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mast .back,
    .mast .brand,
    .mast .page-title,
    .mast .lede,
    .empty,
    .feature,
    .folio-item {
      animation: none;
    }

    .feature-media img,
    .folio-media img,
    .folio-title {
      transition: none;
    }
  }
</style>
