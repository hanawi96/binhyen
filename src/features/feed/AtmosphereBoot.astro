---
/**
 * Gắn --atm-boot-* trong <head> (CSS, trước paint) theo bài đầu.
 * Light + dark cùng lúc — html[data-theme] đã set bởi script theme sớm.
 */
import {
  getAtmospherePreset,
  pickAtmosphereId
} from "./atmosphere-presets";

interface Props {
  contentId?: string | null;
}

const { contentId = null } = Astro.props;
const atmId = contentId ? pickAtmosphereId(contentId, -1) : 0;
const preset = getAtmospherePreset(atmId);
const L = preset.light;
const D = preset.dark;

const bootCss = `:root{--atm-boot-wash:${L.wash};--atm-boot-a:${L.a};--atm-boot-b:${L.b}}html[data-theme="dark"]{--atm-boot-wash:${D.wash};--atm-boot-a:${D.a};--atm-boot-b:${D.b}}`;
---

<style is:inline set:html={bootCss}></style>
