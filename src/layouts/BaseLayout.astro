---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bình Yên - Một chút dịu dàng mỗi ngày",
  description = "Một không gian nhẹ nhàng để khám phá những điều đẹp đẽ, thú vị và ý nghĩa trong cuộc sống."
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <!-- Chạy trước CSS/paint: tránh nháy nền sáng khi đang ở chế độ tối. -->
    <script is:inline>
      try {
        if (localStorage.getItem("binhyen-theme") === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
          document.documentElement.style.colorScheme = "dark";
        }
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f0" />
    <script is:inline>
      try {
        if (document.documentElement.getAttribute("data-theme") === "dark") {
          var themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) themeMeta.setAttribute("content", "#1b2320");
        }
      } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
