
---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bình Yên - Một chút dịu dàng mỗi ngày",
  description = "Một không gian nhẹ nhàng để khám phá những điều đẹp đẽ, thú vị và ý nghĩa trong cuộc sống."
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
